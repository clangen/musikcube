+            /* fullscreen desktop coordinates can differ from the window's client
+            origin on macOS. SDL already tracks the pointer in window points. */
+            if (SDL_GetWindowFlags(bd->Window) & SDL_WINDOW_FULLSCREEN)
+            {
+                SDL_GetMouseState(&mouse_x_global, &mouse_y_global);
+                io.AddMousePosEvent((float)mouse_x_global, (float)mouse_y_global);
+            }
+            else
+            {
+                SDL_GetGlobalMouseState(&mouse_x_global, &mouse_y_global);
