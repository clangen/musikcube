index 251a7d6..c53511a 100644
--- a/src/libprojectM/Renderer/TransitionShaders/TransitionShaderHeaderGlsl330.frag
+++ b/src/libprojectM/Renderer/TransitionShaders/TransitionShaderHeaderGlsl330.frag
@@ -28,6 +28,51 @@ uniform vec3 iBeatAttValues;
 // Samplers
 uniform sampler2D iChannel0;
 uniform sampler2D iChannel1;
+uniform float outgoingSnapshotMotion;
+
+// Animate the frozen outgoing image without running the old preset again.
+vec4 sampleOutgoing(vec2 uv)
+{
+    float progress = clamp(iProgressLinear, 0.0, 1.0) * outgoingSnapshotMotion;
+    float motion = 1.0 - (1.0 - progress) * (1.0 - progress);
+    float angle = 0.40 * motion;
+    float cs = cos(angle);
+    float sn = sin(angle);
+    float aspect = iResolution.x / max(iResolution.y, 1.0);
+    float edgeScale = 1.0 / (cs + abs(sn) * max(aspect, 1.0 / aspect));
+    vec2 point = uv - vec2(0.5);
+    point.x *= aspect;
+    point = mat2(cs, sn, -sn, cs) * point;
+    point.x /= aspect;
+    point *= edgeScale * exp(-0.55 * motion);
+    vec2 samplePoint = point + vec2(0.5);
+    vec4 color = texture(iChannel0, samplePoint);
+    if (progress > 0.001)
+    {
+        vec2 blur = vec2(12.0 * progress) / vec2(textureSize(iChannel0, 0));
+        vec4 softened = color * 0.28;
+        softened += texture(iChannel0, samplePoint + vec2(blur.x, 0.0)) * 0.12;
+        softened += texture(iChannel0, samplePoint - vec2(blur.x, 0.0)) * 0.12;
+        softened += texture(iChannel0, samplePoint + vec2(0.0, blur.y)) * 0.12;
+        softened += texture(iChannel0, samplePoint - vec2(0.0, blur.y)) * 0.12;
+        softened += texture(iChannel0, samplePoint + blur) * 0.06;
+        softened += texture(iChannel0, samplePoint - blur) * 0.06;
+        softened += texture(iChannel0, samplePoint + vec2(blur.x, -blur.y)) * 0.06;
+        softened += texture(iChannel0, samplePoint + vec2(-blur.x, blur.y)) * 0.06;
+        color = softened;
+    }
+
+    float hue = 0.70 * motion;
+    vec3 axis = normalize(vec3(1.0));
+    vec3 shifted = color.rgb * cos(hue) + cross(axis, color.rgb) * sin(hue)
+        + axis * dot(axis, color.rgb) * (1.0 - cos(hue));
+    float luminance = dot(shifted, vec3(0.2126, 0.7152, 0.0722));
+    float saturation = 1.0 + 0.45 * progress * sin(iTime * 4.0);
+    float pulse = 1.0 + 0.20 * progress * sin(iTime * 5.0 + clamp(iBeatValues.x, 0.0, 2.0));
+    color.rgb = max(vec3(0.0), mix(vec3(luminance), shifted, saturation) * pulse);
+    // Fade the animated snapshot into the incoming image, including during wipe transitions.
+    return mix(color, texture(iChannel1, uv), smoothstep(0.0, 1.0, progress));
+}
 
