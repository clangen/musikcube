function(dump_binary output option binary)
  execute_process(COMMAND "${LINKER}" /dump /nologo "${option}" "${binary}"
    RESULT_VARIABLE status OUTPUT_VARIABLE listing ERROR_VARIABLE error)
  if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Cannot inspect ${binary}: ${status}\n${error}")
  endif()
  set(${output} "${listing}" PARENT_SCOPE)
endfunction()

dump_binary(exports /exports "${LIBRARY}")
dump_binary(core_dependencies /dependents "${LIBRARY}")
if(core_dependencies MATCHES "[Ll][Ii][Bb](ssl|crypto)[^\r\n]*[.]dll")
  message(FATAL_ERROR "Windows core must use system TLS: ${core_dependencies}")
endif()
string(REGEX MATCHALL "[\r\n] +[0-9]+ +[0-9A-Fa-f]+ +[0-9A-Fa-f]+ +[^ \r\n]+" rows "${exports}")
foreach(row IN LISTS rows)
  string(REGEX REPLACE ".* +([^ ]+)$" "\\1" symbol "${row}")
  list(APPEND actual "${symbol}")
endforeach()
file(STRINGS "${ALLOWLIST}" expected)
list(SORT actual)
list(SORT expected)
if(NOT actual STREQUAL expected)
  message(FATAL_ERROR "${LIBRARY} exports differ from the ABI allowlist\nExpected: ${expected}\nActual: ${actual}")
endif()

foreach(host IN ITEMS ${GUI} ${CONSOLE})
  dump_binary(imports /dependents "${host}")
  if(NOT imports MATCHES "[\r\n] +musikcore[.]dll[\r\n]")
    message(FATAL_ERROR "${host} does not import musikcore.dll")
  endif()
endforeach()
