cmake_minimum_required(VERSION 3.16)

# compile separate C and C++ providers using only relocated installed headers. keep the
# prefix/build on failure so diagnostics never depend on deleted artifacts.
string(RANDOM LENGTH 12 suffix)
set(root "${BUILD_DIR}/tests/bin/provider-install-${suffix}")
set(original "${root}/original")
set(relocated "${root}/relocated SDK")

function(run)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Installed provider check failed at ${root}: ${ARGV}\n${output}\n${error}")
  endif()
endfunction()

set(config_arguments)
if(TEST_CONFIG)
  set(config_arguments --config "${TEST_CONFIG}")
endif()
run("${CMAKE_COMMAND}" --install "${BUILD_DIR}" ${config_arguments}
  --prefix "${original}" --component musikcoreSDK)
file(RENAME "${original}" "${relocated}")
if(WIN32)
  file(GLOB sdk_dlls RELATIVE "${relocated}/bin" "${relocated}/bin/*.dll")
  list(SORT sdk_dlls)
  set(expected_dlls musikcore.dll)
  if(NOT EXPECT_SYSTEM_HTTP)
    list(APPEND expected_dlls libcurl.dll)
  endif()
  if(NOT EXPECT_SYSTEM_TLS)
    list(APPEND expected_dlls libcrypto-3-x64.dll libssl-3-x64.dll)
  endif()
  list(SORT expected_dlls)
  if(NOT sdk_dlls STREQUAL expected_dlls)
    message(FATAL_ERROR "Unexpected SDK runtime DLLs: ${sdk_dlls}; expected ${expected_dlls}")
  endif()
endif()
set(external "${root}/external provider")
set(generator)
if(WIN32)
  set(generator -G "${TEST_GENERATOR}" -A "${TEST_PLATFORM}")
endif()
run("${CMAKE_COMMAND}" -S "${SOURCE}/tests/support/plugins" -B "${external}"
  ${generator} "-DCMAKE_PREFIX_PATH=${relocated}" "-DCMAKE_BUILD_TYPE=${TEST_CONFIG}"
  "-DCONSUMER_SANITIZERS=${CONSUMER_SANITIZERS}"
  "-DOUTPUT_SOURCE=${SOURCE}/src/plugins/nullout/plugin.cpp")
run("${CMAKE_COMMAND}" --build "${external}" ${config_arguments})
file(READ "${external}/artifact-${TEST_CONFIG}.txt" fixture)
file(READ "${external}/output-artifact-${TEST_CONFIG}.txt" output_fixture)
file(READ "${external}/decoder-artifact-${TEST_CONFIG}.txt" decoder_fixture)
file(READ "${external}/decoder-consumer-${TEST_CONFIG}.txt" decoder_consumer)

foreach(plugin IN ITEMS "${fixture}" "${output_fixture}" "${decoder_fixture}")
  if(UNIX)
    # both C and C++ implementations expose only C and call through host tables.
    file(WRITE "${root}/exports.txt" "mc_plugin_get_api\n")
    run("${CMAKE_COMMAND}" "-DNM=${NM}" "-DAPPLE=${APPLE}" "-DLIBRARY=${plugin}"
      "-DALLOWLIST=${root}/exports.txt" -P "${SOURCE}/tests/scripts/check-exports.cmake")
    execute_process(COMMAND "${NM}" -u "${plugin}" RESULT_VARIABLE status OUTPUT_VARIABLE imports)
    if(NOT status EQUAL 0 OR imports MATCHES "[_ ]mc_[a-z_]+")
      message(FATAL_ERROR "Provider must use host tables rather than import musikcore: ${imports}")
    endif()
  endif()
  if(WIN32)
    execute_process(COMMAND "${LINKER}" /dump /nologo /exports "${plugin}"
      RESULT_VARIABLE status OUTPUT_VARIABLE exports ERROR_VARIABLE error)
    if(NOT status STREQUAL "0")
      message(FATAL_ERROR "Cannot inspect provider exports: ${plugin}\n${error}")
    endif()
    string(REGEX MATCHALL "[\r\n] +[0-9]+ +[0-9A-Fa-f]+ +[0-9A-Fa-f]+ +[^ \r\n]+" rows "${exports}")
    set(symbols)
    foreach(row IN LISTS rows)
      string(REGEX REPLACE ".* +([^ ]+)$" "\\1" symbol "${row}")
      list(APPEND symbols "${symbol}")
    endforeach()
    if(NOT symbols STREQUAL "mc_plugin_get_api")
      message(FATAL_ERROR "Unexpected provider exports in ${plugin}: ${symbols}")
    endif()
    execute_process(COMMAND "${LINKER}" /dump /nologo /imports "${plugin}"
      RESULT_VARIABLE status OUTPUT_VARIABLE imports ERROR_VARIABLE error)
    if(NOT status STREQUAL "0" OR imports MATCHES "[Mm][Uu][Ss][Ii][Kk][Cc][Oo][Rr][Ee]([-.][^ \r\n]*)?[.]dll" OR
        imports MATCHES "[ \t]mc_[a-zA-Z0-9_]+")
      message(FATAL_ERROR "Provider imports musikcore or cannot be inspected: ${plugin}\n${imports}\n${error}")
    endif()
  endif()
endforeach()
if(WIN32)
  execute_process(COMMAND "${LINKER}" /dump /nologo /exports "${NO_ENTRY}"
    RESULT_VARIABLE status OUTPUT_VARIABLE exports ERROR_VARIABLE error)
  if(NOT status STREQUAL "0" OR exports MATCHES "[ \t]mc_plugin_get_api([ \t\r\n]|$)")
    message(FATAL_ERROR "Missing-entry fixture advertises the provider entry or cannot be inspected:\n${exports}\n${error}")
  endif()
endif()
run("${HOST}" "${fixture}")
run("${OUTPUT_HOST}" "${output_fixture}")
set(decoder_plugins "${root}/decoder-plugins")
file(MAKE_DIRECTORY "${decoder_plugins}")
file(COPY "${decoder_fixture}" "${output_fixture}" DESTINATION "${decoder_plugins}")
file(WRITE "${root}/media.bytes" "0123456789abcdef")
file(MAKE_DIRECTORY "${root}/config")
set(isolated_environment "HOME=${root}/config" "XDG_CONFIG_HOME=${root}/config" "APPDATA=${root}/config")
if(WIN32)
  file(GLOB installed_dlls "${relocated}/bin/*.dll")
  get_filename_component(consumer_directory "${decoder_consumer}" DIRECTORY)
  file(COPY ${installed_dlls} DESTINATION "${consumer_directory}")
  run("${CMAKE_COMMAND}" -E env ${isolated_environment}
    "${decoder_consumer}" "${decoder_plugins}" "${root}/media.bytes")
else()
  run("${CMAKE_COMMAND}" -E env ${isolated_environment}
    "LD_LIBRARY_PATH=${relocated}/share/musikcube" "DYLD_LIBRARY_PATH=${relocated}/share/musikcube"
    "${decoder_consumer}" "${decoder_plugins}" "${root}/media.bytes")
endif()
if(DECODER_HOST AND CAPTURE_OUTPUT)
  get_filename_component(capture_name "${CAPTURE_OUTPUT}" NAME)
  run("${NODE}" "${SOURCE}/tests/scripts/run-isolated-test.js"
    "${root}/runs" "${DECODER_HOST}" --stage-minimal --plugin "${decoder_fixture}"
    --plugin "${CAPTURE_OUTPUT}" decoder_contract "${capture_name}" @origin)
endif()
file(READ "${external}/encoder-artifact-${TEST_CONFIG}.txt" encoder_fixture)
file(READ "${external}/application_media-artifact-${TEST_CONFIG}.txt" application_media_fixture)
file(READ "${external}/media-consumer-${TEST_CONFIG}.txt" media_consumer)
file(COPY "${encoder_fixture}" "${application_media_fixture}" DESTINATION "${decoder_plugins}")
get_filename_component(application_media_name "${application_media_fixture}" NAME)
run("${CMAKE_COMMAND}" -E env ${isolated_environment}
  "${media_consumer}" "${decoder_plugins}" "${decoder_plugins}/${application_media_name}"
  "${root}/application.bytes" "${root}/encoded.bytes")
file(REMOVE_RECURSE "${root}")
