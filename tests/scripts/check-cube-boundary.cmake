cmake_minimum_required(VERSION 3.12)

# Read the production executable's actual dynamic imports.
if(APPLE)
  set(args -uj)
else()
  set(args -D --undefined-only --format=posix)
endif()
execute_process(COMMAND "${NM}" ${args} "${APP}"
  RESULT_VARIABLE status OUTPUT_VARIABLE listing ERROR_VARIABLE error)
if(NOT status STREQUAL "0")
  message(FATAL_ERROR "Cannot inspect imports from ${APP}: ${status}\n${error}")
endif()

file(STRINGS "${SOURCE}/src/musikcore/ffi/exports.txt" exports)
string(REGEX MATCHALL "[^\r\n]+" lines "${listing}")
set(usesContext OFF)
foreach(line IN LISTS lines)
  if(APPLE)
    string(REGEX REPLACE "^_" "" symbol "${line}")
  else()
    string(REGEX MATCH "^[^ @]+" symbol "${line}")
  endif()
  if(symbol STREQUAL "mc_context_create")
    set(usesContext ON)
  endif()
  if(symbol MATCHES "^_Z.*5musik" OR (symbol MATCHES "^mc_" AND NOT symbol IN_LIST exports))
    message(FATAL_ERROR "${APP} imports a private symbol: ${symbol}")
  endif()
endforeach()
if(NOT usesContext)
  message(FATAL_ERROR "Expected ${APP} to import mc_context_create")
endif()

# Shared header-only utilities are part of the existing installed SDK.
set(shared_headers sdk/Filesystem.h sdk/HttpClient.h sdk/String.h sdk/version.h)
file(GLOB_RECURSE units
  "${SOURCE}/src/${HOST}/*.cpp" "${SOURCE}/src/${HOST}/*.h" "${SOURCE}/src/${HOST}/*.hpp")
foreach(unit IN LISTS units)
  if(unit MATCHES "/CMakeFiles/")
    continue()
  endif()
  file(STRINGS "${unit}" includes REGEX "^[ \t]*#[ \t]*include[ \t]+[<\"]([.][.]/)*musikcore/")
  foreach(include IN LISTS includes)
    string(REGEX REPLACE "^.*[<\"]([.][.]/)*musikcore/([^>\"]+)[>\"].*$" "\\2" header "${include}")
    if(NOT EXISTS "${SOURCE}/include/musikcore/${header}" AND NOT header IN_LIST shared_headers)
      file(RELATIVE_PATH unit_name "${SOURCE}" "${unit}")
      message(FATAL_ERROR "${unit_name} includes a private header: musikcore/${header}")
    endif()
  endforeach()
endforeach()
