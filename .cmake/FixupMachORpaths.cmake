cmake_minimum_required(VERSION 3.12)

# copied vendor libraries bypass CMake's target install-RPATH processing.
# patch only staged files; the vendor cache and build outputs remain untouched.
if(NOT IS_DIRECTORY "${MUSIKCORE_RUNTIME}")
  message(FATAL_ERROR "Missing staged runtime: ${MUSIKCORE_RUNTIME}")
endif()

file(GLOB binaries "${MUSIKCORE_RUNTIME}/*.dylib"
  "${MUSIKCORE_RUNTIME}/lib/*.dylib" "${MUSIKCORE_RUNTIME}/plugins/*.dylib")
if(EXISTS "${MUSIKCORE_RUNTIME}/plugins/musikcube-projectm")
  list(APPEND binaries "${MUSIKCORE_RUNTIME}/plugins/musikcube-projectm")
endif()
foreach(name IN ITEMS musikcube musikcubed)
  if(EXISTS "${MUSIKCORE_RUNTIME}/${name}")
    list(APPEND binaries "${MUSIKCORE_RUNTIME}/${name}")
  endif()
endforeach()

foreach(binary IN LISTS binaries)
  # patch the real file once, leaving relative library aliases intact.
  if(IS_SYMLINK "${binary}")
    continue()
  endif()
  execute_process(COMMAND otool -l "${binary}" RESULT_VARIABLE status OUTPUT_VARIABLE commands)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Cannot inspect staged Mach-O: ${binary}")
  endif()
  string(REGEX MATCHALL "cmd LC_RPATH\n[ \t]*cmdsize [0-9]+\n[ \t]*path [^\n]+" entries "${commands}")
  list(REMOVE_DUPLICATES entries)
  set(paths)
  set(arguments)
  foreach(entry IN LISTS entries)
    string(REGEX REPLACE ".*\n[ \t]*path (.*) \\(offset [0-9]+\\)" "\\1" path "${entry}")
    if(IS_ABSOLUTE "${path}")
      list(APPEND arguments -delete_rpath "${path}")
    else()
      list(APPEND paths "${path}")
    endif()
  endforeach()

  get_filename_component(directory "${binary}" DIRECTORY)
  set(required "@loader_path")
  if(directory STREQUAL "${MUSIKCORE_RUNTIME}/plugins")
    list(APPEND required "@loader_path/.." "@loader_path/../lib")
  elseif(directory STREQUAL "${MUSIKCORE_RUNTIME}")
    list(APPEND required "@loader_path/lib")
  endif()
  foreach(path IN LISTS required)
    if(NOT path IN_LIST paths)
      list(APPEND arguments -add_rpath "${path}")
    endif()
  endforeach()

  if(arguments)
    execute_process(COMMAND install_name_tool ${arguments} "${binary}" RESULT_VARIABLE status)
    if(NOT status EQUAL 0)
      message(FATAL_ERROR "Cannot normalize staged Mach-O: ${binary}")
    endif()
    # changing load commands invalidates the old ad-hoc signature on Apple Silicon.
    execute_process(COMMAND codesign --force --sign=- "${binary}" RESULT_VARIABLE status)
    if(NOT status EQUAL 0)
      message(FATAL_ERROR "Cannot sign staged Mach-O: ${binary}")
    endif()
  endif()
endforeach()
