function(musikcore_verify_core_boundary directory)
  get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
  foreach(target IN LISTS targets)
    get_target_property(kind "${target}" TYPE)
    if(NOT kind STREQUAL "EXECUTABLE")
      continue()
    endif()
    set(pending "${target}")
    set(visited)
    while(pending)
      list(GET pending 0 dependency)
      list(REMOVE_AT pending 0)
      if(dependency IN_LIST visited)
        continue()
      endif()
      list(APPEND visited "${dependency}")
      foreach(property IN ITEMS LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
        get_target_property(links "${dependency}" "${property}")
        foreach(link IN LISTS links)
          # CMake wraps static-library implementation dependencies in LINK_ONLY.
          string(REGEX REPLACE "^\\$<LINK_ONLY:([^>]+)>$" "\\1" link "${link}")
          if(TARGET "${link}")
            list(APPEND pending "${link}")
          endif()
        endforeach()
      endforeach()
    endwhile()
    if("musikcore" IN_LIST visited AND "musikcore_abi0" IN_LIST visited)
      message(FATAL_ERROR "${target} links both production musikcore and musikcore_abi0")
    endif()
  endforeach()
  get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
  foreach(child IN LISTS children)
    musikcore_verify_core_boundary("${child}")
  endforeach()
endfunction()
